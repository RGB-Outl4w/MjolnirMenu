<Project>
  <!-- Local override: copy to Directory.Build.props.user and set ValheimDir there. -->
  <Import Project="Directory.Build.props.user" Condition="Exists('Directory.Build.props.user')" />
  <PropertyGroup>
    <ValheimDir Condition="'$(ValheimDir)' == '' and '$(VALHEIM_DIR)' != ''">$(VALHEIM_DIR)</ValheimDir>
    <ValheimDir Condition="'$(ValheimDir)' == ''">D:\SteamLibrary\steamapps\common\Valheim</ValheimDir>
    <ValheimManaged>$(ValheimDir)\valheim_Data\Managed</ValheimManaged>
    <BepInExPlugins>$(ValheimDir)\BepInEx\plugins</BepInExPlugins>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
